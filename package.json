{
  "name": "party-games",
  "version": "0.1.0",
  "private": true,
  "description": "Juegos de previa para el celu. Online con salas o pasate el teléfono.",
  "scripts": {
    "dev": "concurrently -k -n web,socket -c cyan,magenta \"next dev --port 3000\" \"tsx watch server/index.ts\"",
    "dev:web": "next dev --port 3000",
    "dev:server": "tsx watch server/index.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "build:mobile": "node scripts/build-mobile.mjs",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test": "vitest run tests/unit",
    "test:multi": "ALLOW_TEST_SEEDS=1 vitest run tests/multi",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "next": "^15.5.4",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
