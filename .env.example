# Puerto HTTP del proceso de producción (Next + Socket.IO juntos).
# Railway / Render / Fly lo inyectan solos.
PORT=3000

# En desarrollo el front corre en :3000 y el socket en :3001.
# Dejá vacío en la web de producción para usar el mismo origen.
# En la APK, si queda vacío el modo en red avisa y el local sigue.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Origen público de la web, para el QR/link de la APK.
# En el browser se usa window.location.origin si esto está vacío.
NEXT_PUBLIC_WEB_ORIGIN=

# Cuántos ms espera el server antes de pasarle el host a otro
# si el anfitrión se desconecta. El original puede reclamar al recargar.
HOST_GRACE_MS=12000

# Orígenes extra para CORS de Socket.IO (separados por coma).
# En prod nunca se usa *. Capacitor (capacitor://localhost, https://localhost,
# http://localhost) y RENDER_EXTERNAL_URL se suman solos.
# Ejemplo: https://la-previa.onrender.com,https://tu-dominio.com
ALLOWED_ORIGINS=

# Solo para tests de integración. Nunca en prod.
ALLOW_TEST_SEEDS=
