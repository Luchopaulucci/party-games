# Puerto HTTP del proceso de producción (Next + Socket.IO juntos).
# Railway / Render / Fly lo inyectan solos.
PORT=3000

# En desarrollo el front corre en :3000 y el socket en :3001.
# Dejá vacío en producción para usar el mismo origen.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Cuántos ms espera el server antes de pasarle el host a otro
# si el anfitrión se desconecta. El original puede reclamar al recargar.
HOST_GRACE_MS=12000

# Solo para tests de integración. Nunca en prod.
ALLOW_TEST_SEEDS=
